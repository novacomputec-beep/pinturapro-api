# =============================================
#  PINTURAPRO API — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha
# =============================================

# Servidor
PORT=3000
NODE_ENV=development

# Banco de Dados (Postgres / Railway)
# Em produção é injetada pela Railway. Para rodar scripts localmente (ex: resetAdmin.js)
# use a connection string EXTERNA do Railway (proxy *.rlwy.net), não a interna.
DATABASE_URL=postgresql://usuario:senha@host:porta/banco

# Supabase
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_KEY=sua_service_role_key_aqui
SUPABASE_ANON_KEY=sua_anon_key_aqui

# JWT
JWT_SECRET=uma_string_longa_e_secreta_aqui
JWT_EXPIRES_IN=7d

# Mercado Pago
MP_ACCESS_TOKEN=seu_access_token_mercadopago
MP_WEBHOOK_SECRET=seu_webhook_secret

# PagBank / PagSeguro
# Token da API do PagBank. É TAMBÉM o segredo que verifica a autenticidade do webhook
# (SHA-256 do token + corpo, comparado ao header x-authenticity-token). OBRIGATÓRIO em
# produção ANTES de habilitar pagamentos: com a verificação ligada e sem este token, TODO
# evento de pagamento é rejeitado (a API loga um aviso alto no boot e a cada requisição).
PAGBANK_TOKEN=seu_token_pagbank
PAGBANK_ENV=production
# Verificação de assinatura do webhook. LIGADA por padrão (qualquer valor ou ausência).
# Defina explicitamente como 'false' APENAS para diagnosticar o formato de assinatura numa
# integração nova — nunca em produção com pagamentos ativos, pois desligar aceita eventos forjados.
WEBHOOK_ENFORCE_SIGNATURE=true

# E-mail (Nodemailer — pode usar Gmail ou SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASS=sua_senha_de_app
EMAIL_FROM=PinturaPro <noreply@pinturapro.com.br>

# App
FRONTEND_URL=http://localhost:8081
ADMIN_URL=http://localhost:3001
